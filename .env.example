# Copy this file to .env or .env.development and fill in values

# Platform Database
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=hrms_platform
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=password
PLATFORM_DB_DIALECT=postgres

# Tenant Database
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=password
TENANT_DB_DIALECT=postgres

# Services
AUTH_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
API_GATEWAY_PORT=3000

# JWT / Security (Required: 32+ character random string)
JWT_SECRET=your-minimum-32-character-jwt-secret-key-here
JWT_EXPIRY=60m
JWT_REFRESH_EXPIRY=7d

# Gateway <-> Microservice message signing (Required: 32+ character random string, distinct from JWT_SECRET)
MICROSERVICE_SIGNING_SECRET=your-minimum-32-character-signing-secret-here

# Field-level encryption for sensitive columns (Required: 64-char hex string, 32 bytes — generate with `openssl rand -hex 32`)
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-openssl-rand-hex-32

# SuperAdmin Initial Seed Credentials (Required: 12+ chars, upper, lower, number, symbol)
SUPERADMIN_EMAIL=superadmin@system.com
SUPERADMIN_PASSWORD=YourStrongSuperAdminPassword2026!

# Password Policy
PASSWORD_EXPIRY_DAYS=90

# Mail Service Configuration (Nodemailer / SMTP)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_NAME=HRMS Platform
MAIL_FROM_EMAIL=noreply@hrms.local
MAIL_REPLY_TO=support@hrms.local

# File Storage Service Configuration (Local / AWS S3 Fallback)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_ENDPOINT=

# CORS (comma-separated list of allowed frontend origins, no wildcards)
# Must list the frontend exactly: the refresh-token cookie is sent with
# credentialed requests, which browsers refuse against a wildcard origin.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh-token cookie (httpOnly; the browser never exposes it to JavaScript).
# `lax` is correct whenever the app and API share a registrable domain —
# app.example.com + api.example.com, or localhost:5173 + localhost:3000, since
# ports don't affect "site". Set `none` only for a genuinely cross-site API;
# browsers then require the cookie to be Secure, which the gateway forces.
REFRESH_COOKIE_SAMESITE=lax
# Defaults to 7d, matching JWT_REFRESH_EXPIRES_IN. Keep the two in step.
REFRESH_COOKIE_MAX_AGE_MS=604800000

# Origin of the frontend portal. Used to build links that are emailed to
# users - the organization admin invitation's "Accept Invitation" button
# points at <FRONTEND_URL>/onboarding?token=...
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Swagger UI at /api/docs. Served automatically whenever NODE_ENV is not
# `production`. Set this to `true` to serve it in production as well — only do
# that on a host that is not publicly reachable: the page lists every route and
# DTO field and includes a live "Try it out" console against the real API.
# ENABLE_API_DOCS=true

# Platform Status widget (SuperAdmin dashboard) — optional.
# When unset, storage.quotaGB/percentageUsed are returned as null instead
# of a guessed value (storage.usedGB is always computed live regardless).
PLATFORM_STORAGE_QUOTA_GB=

# ==========================================
# Microservice TCP bind addresses
# ==========================================
# These ports expose every @MessagePattern as an unauthenticated admin API —
# the gateway's JWT/guard stack runs in a different process and does not
# protect them. They now bind 127.0.0.1 by default. Override ONLY for a
# multi-host deployment, and only to an interface that is not publicly
# reachable.
# AUTH_SERVICE_BIND_HOST=127.0.0.1
# TENANT_SERVICE_BIND_HOST=127.0.0.1
# USER_SERVICE_BIND_HOST=127.0.0.1

# ==========================================
# Schema management
# ==========================================
# Creates missing tenant tables on the first connection after a start.
# Defaults to on outside production, off in production, where tenant schema
# must come from provisioning or a migration run instead.
# TENANT_DB_AUTO_SYNC=false
# By default missing tables are created and new columns added to existing
# ones (one catalog query; nothing is ever altered or dropped).
# `full` runs Sequelize sync() model by model (~3 round trips per model) — use
# it when a change adds an index to an existing table.
# TENANT_DB_SYNC_MODE=full
# Print every SQL statement. Slows every request noticeably; debugging only.
# DB_LOG_SQL=true

# ==========================================
# Gateway
# ==========================================
# Maintenance-mode lookups are cached for this long instead of hitting
# auth-service on every request. Raise to cut chatter, lower to make the
# toggle propagate faster.
# MAINTENANCE_STATE_TTL_MS=60000
# Swagger is served outside production automatically. Set true to expose
# /api/docs in production as well — it maps every route, so treat it as a
# deliberate choice.
# ENABLE_SWAGGER=false

# ==========================================
# Microservice message signing
# ==========================================
# Every gateway -> service and service -> service message is signed with
# MICROSERVICE_SIGNING_SECRET (above) and verified by RpcSignatureGuard,
# which is registered globally in all three microservices.
#
# Enforcement defaults ON in production and OFF elsewhere. With it off, an
# unsigned message is logged and allowed, so a partially-rolled deployment
# (an old gateway against a new service) keeps working; with it on, it is
# rejected. Turn it on for any environment reachable by more than the
# developer running it.
# MICROSERVICE_SIGNING_ENFORCED=true

# ==========================================
# Connection pooling
# ==========================================
# Worst-case connections against Postgres are
#   MAX_TENANT_CONNECTIONS x TENANT_DB_POOL_MAX x (number of service processes)
# Two services each cache up to MAX_TENANT_CONNECTIONS pools, so against a
# plain Postgres the ceiling is 50 x 2 x 2 = 200. Check it against your
# server's max_connections before raising either value.
# Behind a connection pooler (PgBouncer, Neon `-pooler` hosts — detected from
# the host name, or set DB_POOLER=true) the default per-tenant max is 8, so a
# page's parallel queries aren't squeezed through two connections.
# MAX_TENANT_CONNECTIONS=50
# TENANT_DB_POOL_MAX=8
# TENANT_DB_POOL_MIN=0
# DB_POOLER=true
# How long an unused pooled connection stays open. Reopening one costs a TLS
# handshake + login (~1.4s to a distant region), so keep this generous.
# TENANT_DB_POOL_IDLE_MS=300000
# DB_POOL_IDLE_MS=300000
# TENANT_CONNECTION_IDLE_TIMEOUT_MS=600000

# ==========================================
# Gateway guard caches
# ==========================================
# Module-entitlement decisions are cached per tenant+module+action for this
# long, removing a TCP hop to tenant-service from most requests. Only grants
# are cached, so a newly purchased module takes effect immediately; a revoked
# one takes up to this long.
# MODULE_ACCESS_TTL_MS=60000
# IP allowlist decisions are cached per source IP for this long. When the
# allowlist is switched on and auth-service cannot be reached, the gateway
# fails CLOSED (503) rather than silently disabling the control.
# IP_ALLOWLIST_TTL_MS=15000

# ==========================================
# AI Assistant (api-gateway + auth-service)
# ==========================================
# Anthropic API key for the AI Assistant. Without it the chat panel shows a
# "not configured" message; nothing else is affected.
# ANTHROPIC_API_KEY=sk-ant-...
# Model and reasoning effort for answers (low | medium | high | xhigh | max).
# AI_ASSISTANT_MODEL=claude-opus-5-5
# AI_ASSISTANT_EFFORT=medium
# Days a conversation is kept after its last message (auth-service).
# AI_HISTORY_RETENTION_DAYS=90
