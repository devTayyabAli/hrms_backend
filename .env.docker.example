# Production settings for docker-compose.yml.
#   cp .env.docker.example .env.docker   and fill in every value.
# .env.docker is git-ignored (.env.*) and never copied into the image.
#
# Service hosts, bind addresses, ports and NODE_ENV are set in
# docker-compose.yml — don't repeat them here.

# ── Databases ────────────────────────────────────────────────────────────────
# External Postgres (Neon, RDS, a managed DB) or `postgres` when running the
# compose `db` profile. The tenant DB user needs CREATEDB: one database is
# created per organization.
PLATFORM_DB_HOST=postgres
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=hrms_platform
PLATFORM_DB_USER=hrms
PLATFORM_DB_PASSWORD=change-me
PLATFORM_DB_DIALECT=postgres

TENANT_DB_HOST=postgres
TENANT_DB_PORT=5432
TENANT_DB_USER=hrms
TENANT_DB_PASSWORD=change-me
TENANT_DB_DIALECT=postgres

# true for any database reached over the internet (Neon hosts turn it on automatically).
DB_SSL=false

