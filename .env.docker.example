# ── Secrets (generate fresh ones — never reuse development values) ───────────
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=60m
JWT_REFRESH_EXPIRY=7d
# openssl rand -base64 48   (different from JWT_SECRET; shared by all four services)
MICROSERVICE_SIGNING_SECRET=
# openssl rand -hex 32   — keep it forever: it decrypts stored sensitive fields
ENCRYPTION_KEY=

# First super-admin, created on first start (12+ chars, upper, lower, digit, symbol).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
PASSWORD_EXPIRY_DAYS=90

# ── Your domains ─────────────────────────────────────────────────────────────
# The frontend's exact origin(s), comma-separated, no wildcards.
ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
# lax when app and API share a registrable domain (app.example.com + api.example.com).
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_MAX_AGE_MS=604800000

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=HRMS Platform
MAIL_FROM_EMAIL=noreply@example.com
MAIL_REPLY_TO=support@example.com

# ── File storage ─────────────────────────────────────────────────────────────
# local = the `uploads` Docker volume on this VPS (back it up!), or s3.
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# ── Optional ─────────────────────────────────────────────────────────────────
# ENABLE_API_DOCS=false
# PLATFORM_STORAGE_QUOTA_GB=
# MAX_TENANT_CONNECTIONS=50
# TENANT_DB_POOL_MAX=2
